# Public base URL for sitemap, OG tags and canonical links
# In production, set to your actual domain (no trailing slash)
NEXT_PUBLIC_BASE_URL=https://seu-dominio.com

# Password gate (protects the whole site, including /jobs) — see src/proxy.ts
SITE_PASSWORD=
# Long random string used to sign the auth cookie, e.g. `openssl rand -hex 32`
SITE_AUTH_SECRET=
